# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dylib

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
.env/

# =============================================================================
# plumeIR-specific
# =============================================================================

# Debug and test outputs — never committed.  Top-level debug/*.py are the
# validation and diagnostic scripts (moved from test/ in M5) and stay tracked;
# everything else under debug/ (baselines, logs, scratch) is local.
debug/*
!debug/*.py
test/debug/
test/demo_output/

# Demo/measurement data — local working copies only, NEVER committed.
# Spectra are large binaries; committing them is effectively irreversible
# (see the public repo's RFM purge). Distribute datasets via release assets
# or Zenodo, not git history.
/data/

# Reference cache — large, machine-specific, regenerated on demand
plumeIR/cache/
*.npz
*.nc
*.pkl

# Run outputs — results go in user-specified output directories, not the repo
*.csv
*.xlsx
plumeIRlog.txt

# RFM working files — generated at runtime by RFMwrapper
rfm.drv
rfm.log
*.drv
opt*.out
tra*.out
rad*.out
bbt*.out

# =============================================================================
# Tools and editors
# =============================================================================
.DS_Store
.spyproject/
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# pytest
.pytest_cache/
htmlcov/
.coverage

# Command-line run folders (python -m plumeIR, default --output-dir)
plumeIR_runs/
